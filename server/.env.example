# Copy to .env and fill in. Get a key at https://console.groq.com (free tier).
GROQ_API_KEY=gsk_your_key_here

# Model IDs live here so a Groq rotation is a one-line fix (PRD §0).
# Verify against https://console.groq.com/docs/models before a demo.
GROQ_STT_MODEL=whisper-large-v3
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

PORT=3000
